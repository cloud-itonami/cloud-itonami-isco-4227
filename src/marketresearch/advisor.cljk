(ns marketresearch.advisor
  "MarketResearchInterviewersAdvisor — proposes a response operation
  (approve a response, approve a quota reopening) for a registered
  organization. Swappable mock/llm; the advisor ONLY proposes —
  `marketresearch.governor` checks the quota ceiling and consent gate
  independently. Modeled on cloud-itonami-isco-4311's advisor.

  A proposal: {:op :approve-response|:approve-quota-reopening
               :effect :propose :study-id str :segment str
               :segment-count-after number :consent-obtained bool
               :stake kw :confidence n :rationale str}"
  ;; clojure.edn, not clojure.core/read-string: this parses untrusted
  ;; advisor output, and the core reader executes #=(...) at read time.
  (:require [kotoba.lang.edn :as edn]))

(defprotocol Advisor
  (-advise [advisor store request] "request -> proposal map"))

(defn- infer [_store {:keys [op stake study-id segment segment-count-after
                             consent-obtained] :as request}]
  {:op op
   :effect :propose
   :study-id study-id
   :segment segment
   :segment-count-after segment-count-after
   :consent-obtained consent-obtained
   :stake (or stake :low)
   :confidence (case (or stake :low) :high 0.7 :medium 0.85 :low 0.95)
   :rationale (str "proposed " (name op) " for client " (:client-id request))})

(defn mock-advisor []
  (reify Advisor
    (-advise [_ store request] (infer store request))))

(def ^:private system-prompt
  "You are a survey/market-research advisor. Given a request, propose
   an :op, the :study-id, :segment, :segment-count-after and
   :consent-obtained, an honest :confidence and a :stake. Never call
   an over-quota response or an unconsented response conforming — the
   governor checks both against the registered study record.")

(defn- parse-proposal [content]
  (try
    (let [p (edn/read-string content)]
      (if (map? p)
        (assoc p :effect :propose)
        {:op :unknown :effect :propose :confidence 0.0 :stake :high
         :rationale "unparseable LLM response"}))
    (catch #?(:clj Exception :cljs js/Error) _
      {:op :unknown :effect :propose :confidence 0.0 :stake :high
       :rationale "LLM response parse failure"})))

(defn llm-advisor
  [chat-model model-generate-fn gen-opts]
  (reify Advisor
    (-advise [_ _store request]
      (let [msgs [{:role :system :content system-prompt}
                  {:role :user :content (str "operation request: " (pr-str request))}]
            resp (model-generate-fn chat-model msgs gen-opts)]
        (parse-proposal (:content resp))))))
