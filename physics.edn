;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README: market research interviewers (ISCO 4227) are a Wave-0 cognitive
;; occupation (no robotics gate); blueprint.edn declares
;; :itonami.blueprint/robotics true. The physical edge of intercept
;; interviewing is handing the survey tablet to a respondent, and moving the
;; survey station between intercept points in a shopping centre. These cases
;; declare that edge; questionnaire work stays cognitive.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-4227"
 :cases
 [{:id :survey-tablet-handoff
   :kind :manipulator
   :procedure "arm lifts the survey tablet from its dock and holds it out at chest height to the respondent"
   :params {:l1-m 0.30 :l2-m 0.25 :m1-kg 1.5 :m2-kg 1.0
            :from [0.15 0.40] :to [0.50 0.10] :duration-s 1.0 :steps 300}
   :sweep {:param :payload-kg :values [0.3 0.5 0.7 1.0 1.5]}
   :quantity :peak-tau1-nm
   :limit {:max 15.0 :basis "estimate: continuous shoulder torque of a desktop arm (~1-3 kg class)"}
   :boundary {:lo 0.05 :hi 8.0}}
  {:id :station-to-next-intercept-point
   :kind :transport
   :procedure "robot moves the survey station from one intercept point to the next along the mall concourse"
   :params {:mass-kg 50.0 :payload-kg 8.0 :v-max-mps 0.8 :a-max-mps2 0.4
            :brake-decel-mps2 0.6 :drive-force-n 90.0 :crr 0.025
            :cog-height-m 0.70 :support-half-length-m 0.28}
   :sweep {:param :distance-m :values [20.0 50.0 100.0 150.0 250.0]}
   :quantity :cycle-time-s
   :limit {:max 150.0 :basis "estimate: relocation must fit in the gap between interviews, about 2.5 minutes"}
   :boundary {:lo 5.0 :hi 600.0}}]}
